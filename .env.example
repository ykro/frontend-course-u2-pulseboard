# Modos de arranque (src/config.ts decide cuál con estas variables):
# - demo: sin las cuatro VITE_FIREBASE_*. Firebase falso en memoria y la API
#   REST del Sandbox simulada con MSW en el navegador.
# - mixto: con las cuatro VITE_FIREBASE_* de tu proyecto y VITE_SANDBOX_URL
#   vacía. Auth y comentarios en tu Firebase real; la API REST la sigue
#   simulando MSW en el navegador (public/mockServiceWorker.js).
# - completo: además VITE_SANDBOX_URL con la URL de un Sandbox real.
# No hay secretos aquí: la configuración web de Firebase es pública por diseño
# y la protegen las reglas de Firestore y los dominios autorizados de Auth.
# Copia este archivo a .env.local (no se versiona) y completa lo que uses.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_SANDBOX_URL=
